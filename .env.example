PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/mfm_dashboard
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5173

# Primary mail provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MFM APD" <no-reply@yourdomain.com>
EMAIL_SEND_TIMEOUT_MS=8000

# Secondary mail provider for future use
RESEND_API_KEY=
RESEND_FROM="MFM APD <no-reply@yourdomain.com>"
LOG_LEVEL=info