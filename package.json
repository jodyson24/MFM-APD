{
  "name": "mfm-apd",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "server": "nodemon server.js",
    "seed": "node lib/seed.js",
    "build": "npm ci --prefix frontend --include=dev && npm run build --prefix frontend",
    "postinstall": "npm ci --prefix frontend --include=dev",
    "client": "npm run dev --prefix frontend",
    "server-install": "npm install",
    "client-install": "cd frontend && npm install",
    "install-all": "concurrently \"npm run server-install\" \"npm run client-install\"",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jodyson24/MFM-APD.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jodyson24/MFM-APD/issues"
  },
  "homepage": "https://mfm-apd.onrender.com",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "concurrently": "^10.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.10.1",
    "winston": "^3.19.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
